# Copy this file to `.env` and adjust the values for your machine.
# `.env` is git-ignored and must never contain committed secrets.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Phase 15 PDF export. Optional: when unset, the exporter searches the common open-source
# font locations (DejaVu, Liberation, FreeSerif, Noto) and refuses the request with 503
# rather than producing a document whose text it cannot draw. Point these at a
# Unicode-capable TrueType font (Latin plus Arabic) in a deployment that lacks one.
DJANGO_PDF_EXPORT_FONT_REGULAR=
DJANGO_PDF_EXPORT_FONT_BOLD=

# Phase 15 semester teaching plan import limits, in bytes and rows.
DJANGO_SEMESTER_PLAN_IMPORT_MAX_BYTES=5242880
DJANGO_SEMESTER_PLAN_IMPORT_MAX_SHEET_ROWS=2000
DJANGO_SEMESTER_PLAN_IMPORT_MAX_TOTAL_ROWS=10000
DJANGO_SEMESTER_PLAN_IMPORT_MAX_SCANNED_ROWS=20000

# Phase 16 local SQLite backup directory. Defaults to <project>/var/backups, which is
# git-ignored. Backups contain the whole database, so keep this directory private.
DJANGO_LOCAL_BACKUP_DIR=

# Phase 17 production hardening. These only take effect with DJANGO_DEBUG=false, and each
# one can be overridden. DJANGO_SECRET_KEY and DJANGO_ALLOWED_HOSTS are mandatory then.
# DJANGO_API_DOCS_ENABLED=false          # /api/schema/ and /api/docs/ exposure
# DJANGO_CSRF_TRUSTED_ORIGINS=https://frontend.example.test
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false   # deliberate choice, not a default
# DJANGO_SECURE_HSTS_PRELOAD=false              # deliberate choice, not a default
# DJANGO_TRUST_X_FORWARDED_PROTO=true    # only behind a proxy that sets the header
